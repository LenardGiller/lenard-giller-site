---
import Layout from "../../layouts/Layout.astro";
import WorkContent from "../../components/WorkContent.astro";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";

export async function getStaticPaths() {
	const works = await getCollection("works");
	return works.map((work) => ({
		params: { slug: work.id },
		props: { work },
	}));
}

const { work } = Astro.props;
const { data } = work;

// Every /works/<slug>/ page renders the full feed, all works in order — the
// only thing that changes between URLs is which one it scrolls to on load
// (via currentWorkSlug, handled in Layout.astro) and this page's own SEO
// metadata below. That way scrolling up from any project always works too.
const allWorks = (await getCollection("works")).sort((a, b) => a.data.order - b.data.order);

const allImages = import.meta.glob("/src/assets/works/*/*.{jpg,avif}", {
	eager: true,
}) as Record<string, { default: ImageMetadata }>;

const leadImagePath = data.images[0] && `/src/assets/works/${work.id}/${data.images[0]}`;
const leadImage = leadImagePath ? allImages[leadImagePath]?.default : undefined;

// Raw, unformatted meta description: literally the page's own content, in the
// order it actually appears on the page (title, medium/year, venue, body text),
// not a written summary — cut off wherever it runs long, same as it reads on
// the page itself.
const descriptionLines: string[] = [data.title];

if (!data.hideTopYear) {
	const medYear = [data.medium, data.year].filter(Boolean).join(". ");
	if (medYear) descriptionLines.push(medYear);
}

const venuesAfterImages = data.venuesAfterImages ?? 0;
const allVenues = data.venues ?? [];
const mainVenues = venuesAfterImages > 0 ? allVenues.slice(0, -venuesAfterImages) : allVenues;
const firstVenue = mainVenues[0];
if (firstVenue) {
	if (firstVenue.exhibitionTitle) descriptionLines.push(firstVenue.exhibitionTitle);
	const venueLine = [firstVenue.venue, firstVenue.dates].filter(Boolean).join(", ");
	if (venueLine) descriptionLines.push(venueLine);
	if (firstVenue.curator) descriptionLines.push(`Curated by ${firstVenue.curator}.`);
}

if (work.body && work.body.trim().length > 0) {
	const plainBody = work.body
		.replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
		.replace(/[*_#>`]/g, "")
		.trim();
	descriptionLines.push("", plainBody);
}

const rawDescription = descriptionLines.join("\n");
const description =
	rawDescription.length > 300 ? rawDescription.slice(0, 300) : rawDescription;

// sediment is the site's landing page (/ redirects here), so its share
// image should be the same approved crop used as the sitewide default,
// not an auto-generated, uncropped version of its own lead photo.
const ogImage =
	work.id === "sediment"
		? undefined
		: leadImage
			? await getImage({ src: leadImage, width: 1200, format: "jpg", quality: 80 })
			: undefined;
---

<Layout
	title={`${data.title} — Lenard Giller`}
	description={description}
	image={ogImage?.src}
	active="works"
	currentWorkSlug={work.id}
>
	<div class="work-feed">
		{allWorks.map((w) => (
			<WorkContent work={w} />
		))}
	</div>
</Layout>
