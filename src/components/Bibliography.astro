---
import { getCollection, render } from "astro:content";

// Shared with src/pages/works/[slug].astro, which appends this same list
// at the end of the continuous works feed (so scrolling past the last
// project continues straight into it) - kept as its own component rather
// than duplicated markup so both call sites always render identically.
const entries = await getCollection("bibliography");
entries.sort((a, b) => a.data.order - b.data.order);
const rendered = await Promise.all(
	entries.map(async (entry) => ({
		year: entry.data.year,
		Content: (await render(entry)).Content,
	})),
);
---

<div class="group">
	{
		rendered.map(({ year, Content }) => (
			<div class="bib-entry">
				<span class="year">{year}</span>
				<Content />
			</div>
		))
	}
</div>
