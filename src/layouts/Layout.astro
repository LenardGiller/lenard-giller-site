---
import "../styles/global.css";
import { getCollection } from "astro:content";

interface Props {
	title: string;
	description?: string;
	active: "home" | "works" | "bibliography" | "contacts";
	currentWorkSlug?: string;
	image?: string;
}

const { title, description, active, currentWorkSlug, image } = Astro.props;

const works =
	active === "works"
		? (await getCollection("works")).sort((a, b) => a.data.order - b.data.order)
		: [];

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image ?? "/og-default.jpg", Astro.site);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		{description && <meta property="og:description" content={description} />}
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		{description && <meta name="twitter:description" content={description} />}
		<meta name="twitter:image" content={ogImageURL} />
	</head>
	<body>
		<div class="site">
			<div class="sidebar">
				<p class="email">lenard.giller(at)gmail.com</p>
				<nav>
					<a href="/" aria-current={active === "home" ? "page" : undefined}>
						home
					</a>
					<a
						id="works-link"
						href="/works"
						aria-current={active === "works" && !currentWorkSlug ? "page" : undefined}
					>
						works
					</a>
					{active === "works" && (
						<div class="works-sublist">
							{works.map((work) => (
								<a
									href={`/works/${work.id}/`}
									aria-current={work.id === currentWorkSlug ? "page" : undefined}
								>
									{work.data.title}
								</a>
							))}
						</div>
					)}
					<a href="/bibliography" aria-current={active === "bibliography" ? "page" : undefined}>
						bibliography
					</a>
					<a href="/contacts" aria-current={active === "contacts" ? "page" : undefined}>
						contact
					</a>
				</nav>
			</div>
			<main class="content">
				<slot />
			</main>
		</div>
		<script>
			const worksLink = document.getElementById("works-link");
			const sublist = document.querySelector<HTMLElement>(".works-sublist");

			if (worksLink && sublist) {
				worksLink.addEventListener("click", (event) => {
					event.preventDefault();
					sublist.style.display = sublist.style.display === "none" ? "" : "none";
				});
			}
		</script>
	</body>
</html>
